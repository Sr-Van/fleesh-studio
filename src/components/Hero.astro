---
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

// Abertura: o logotipo cromado é o protagonista.
const sparkles = [
  { top: '14%', left: '8%', size: 34, t: '3.2s', d: '0s' },
  { top: '22%', left: '86%', size: 46, t: '2.6s', d: '.6s' },
  { top: '68%', left: '6%', size: 24, t: '3.8s', d: '1.1s' },
  { top: '76%', left: '90%', size: 30, t: '2.9s', d: '.3s' },
  { top: '8%', left: '54%', size: 18, t: '3.4s', d: '1.6s' },
  { top: '86%', left: '40%', size: 20, t: '4s', d: '.9s' },
];
---

<section id="topo" class="relative isolate min-h-[100svh] flex flex-col items-center justify-center overflow-hidden px-4 pt-24 pb-16 text-center">

  {sparkles.map((s) => (
    <img
      src="/y2k/star.webp"
      alt=""
      aria-hidden="true"
      width="176"
      height="163"
      decoding="async"
      class="sparkle absolute pointer-events-none select-none"
      style={`top:${s.top};left:${s.left};width:${s.size}px;--t:${s.t};--d:${s.d}`}
    />
  ))}

  <p class="fade-up font-mono text-[11px] sm:text-xs uppercase tracking-[0.35em] text-ink-200" style="--d:900ms">
    {t.hero.eyebrow}
  </p>

  <h1 class="relative mt-4 w-full mx-auto max-w-[min(820px,100%,calc((100svh-260px)*1.336))]" data-logo-tilt>
    <span class="sr-only">Fleesh Studios</span>
    <!-- Brilho roxo preso à logo: termina antes do "Entrar" para não vazar na próxima seção -->
    <div aria-hidden="true" class="absolute -inset-x-[10%] top-0 bottom-0 -z-10 pointer-events-none bg-[radial-gradient(closest-side,rgba(131,88,255,0.22),rgba(131,88,255,0.08)_60%,transparent)]"></div>
    <div class="logo-enter">
      <div class="logo-float relative">
        <img
          src="/y2k/logo-sm.webp"
          srcset="/y2k/logo-sm.webp 760w, /y2k/logo.webp 1462w"
          sizes="(min-width: 1024px) 900px, 92vw"
          width="1462"
          height="1094"
          alt=""
          fetchpriority="high"
          decoding="async"
          class="w-full h-auto drop-shadow-[0_0_24px_rgba(131,88,255,0.3)]"
        />
      </div>
    </div>
  </h1>

  <p class="fade-up mt-2 sm:-mt-4 font-display font-semibold text-lg sm:text-2xl tracking-tight chrome-text" style="--d:1200ms">
    {t.hero.subtitle}
  </p>

  <a href="#manifesto" class="fade-up group mt-14 inline-flex flex-col items-center gap-3 text-ink-400 hover:text-ink-50 transition-colors" style="--d:1500ms">
    <span class="font-mono text-[10px] uppercase tracking-[0.4em]">{t.hero.cta}</span>
    <span class="relative h-12 w-[1px] overflow-hidden bg-white/15" aria-hidden="true">
      <span class="drop absolute inset-x-0 top-0 h-1/2 bg-ink-50"></span>
    </span>
  </a>
</section>

<style>
  .drop { animation: drop 1.8s ease-in-out infinite; }
  @keyframes drop {
    from { transform: translateY(-100%); }
    to { transform: translateY(200%); }
  }
</style>

<script>
  // Inclinação 3D do logo seguindo o mouse
  const box = document.querySelector<HTMLElement>('[data-logo-tilt]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (box && !calm && window.matchMedia('(hover: hover)').matches) {
    box.style.transition = 'transform 600ms cubic-bezier(0.16,1,0.3,1)';
    window.addEventListener(
      'pointermove',
      (e) => {
        const x = e.clientX / window.innerWidth - 0.5;
        const y = e.clientY / window.innerHeight - 0.5;
        box.style.transform = `perspective(1200px) rotateY(${x * 10}deg) rotateX(${-y * 8}deg)`;
      },
      { passive: true }
    );
  }
</script>
