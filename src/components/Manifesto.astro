---
import { PORTFOLIO_ITEMS } from '../data/siteData';

const fan = PORTFOLIO_ITEMS.filter((i) => i.featured).slice(0, 3);
const pose = ['-rotate-[8deg] -translate-x-[18%] translate-y-[6%]', 'rotate-[2deg] z-10', 'rotate-[10deg] translate-x-[18%] translate-y-[8%]'];
---

<section id="manifesto" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 grid lg:grid-cols-2 gap-16 items-center">
    <div>
      <p data-reveal class="font-mono text-xs uppercase tracking-[0.3em] text-flame-500 glow">✦ Por que thumbnails?</p>
      <blockquote data-reveal="mask" class="mt-6 font-display font-extrabold tracking-[-0.03em] leading-[1.02] text-[clamp(1.9rem,6vw,3.4rem)] text-ink-50">
        Você nunca tem uma <span class="chrome-text">segunda chance</span> de causar uma primeira impressão.
      </blockquote>
      <p data-reveal class="mt-6 max-w-[48ch] text-ink-200 leading-relaxed" style="--d:150ms">
        A capa é o primeiro frame do seu vídeo — e às vezes o único. Uma boa thumbnail é a diferença entre algumas views e alguns milhares.
        Aqui ela é tratada como arte: luz, cromo, expressão e caos sob controle.
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[520px] aspect-[4/3]" data-reveal style="--d:200ms">
      {fan.map((item, i) => (
        <button
          type="button"
          data-open-piece={item.id}
          data-cursor="Ver"
          class={`absolute inset-x-[7%] top-[16%] rounded-2xl overflow-hidden y2k-border shadow-[0_30px_60px_-15px_rgba(0,0,0,0.9)] transition-transform duration-700 ease-art hover:-translate-y-3 hover:rotate-0 hover:z-20 ${pose[i]}`}
          aria-label={`Abrir obra: ${item.title}`}
        >
          <div class="art-frame aspect-video" style={`--tone:${item.dominantPalette}`}>
            <img
              src={item.thumbSrc}
              srcset={`${item.thumbSrc} 640w, ${item.src} 1280w`}
              sizes="(min-width: 1024px) 450px, 80vw"
              width="640"
              height="360"
              alt={item.alt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </button>
      ))}
      <img src="/y2k/star.webp" alt="" aria-hidden="true" width="176" height="163" loading="lazy" class="sparkle absolute -top-2 right-2 w-12 z-30 pointer-events-none" style="--t:2.8s" />
    </div>
  </div>
</section>
