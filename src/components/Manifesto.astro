---
import { getPortfolioItems } from '../data/siteData';
import { getTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const fan = getPortfolioItems(locale)
  .filter((i) => i.featured)
  .slice(0, 3);
const pose = ['-rotate-[8deg] -translate-x-[18%] translate-y-[6%]', 'rotate-[2deg] z-10', 'rotate-[10deg] translate-x-[18%] translate-y-[8%]'];
---

<section id="manifesto" class="relative min-h-[90svh] flex items-center py-28 sm:py-40">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div>
      <p data-reveal class="font-mono text-sm sm:text-base uppercase tracking-[0.3em] text-flame-500 glow">{t.manifesto.eyebrow}</p>
      <p data-reveal class="mt-6 max-w-[52ch] text-xl sm:text-2xl lg:text-[1.7rem] text-ink-50 leading-relaxed" style="--d:150ms">
        {t.manifesto.body}
      </p>
    </div>

    <div class="relative mx-auto w-full max-w-[720px] aspect-[4/3]" data-reveal style="--d:200ms">
      {fan.map((item, i) => (
        <button
          type="button"
          data-open-piece={item.id}
          data-cursor={t.manifesto.cursorLabel}
          class={`absolute inset-x-[7%] top-[16%] rounded-2xl overflow-hidden y2k-border shadow-[0_30px_60px_-15px_rgba(0,0,0,0.9)] transition-transform duration-700 ease-art hover:-translate-y-3 hover:rotate-0 hover:z-20 ${pose[i]}`}
          aria-label={t.manifesto.openPieceLabel(item.title)}
        >
          <div class="art-frame aspect-video" style={`--tone:${item.dominantPalette}`}>
            <img
              src={item.thumbSrc}
              srcset={`${item.thumbSrc} 640w, ${item.src} 1280w`}
              sizes="(min-width: 1024px) 620px, 80vw"
              width="640"
              height="360"
              alt={item.alt}
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </button>
      ))}
      <img src="/y2k/star.webp" alt="" aria-hidden="true" width="176" height="163" loading="lazy" class="sparkle absolute -top-2 right-2 w-16 z-30 pointer-events-none" style="--t:2.8s" />
    </div>
  </div>
</section>
